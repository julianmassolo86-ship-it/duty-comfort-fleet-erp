{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "N\u00famero correlativo de la OC (ej: OC-000001)"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID del proveedor"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la orden"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "aprobada",
        "recibida",
        "cancelada"
      ],
      "default": "borrador",
      "description": "Estado de la orden"
    },
    "items": {
      "type": "array",
      "description": "\u00cdtems de la orden",
      "items": {
        "type": "object",
        "properties": {
          "spare_part_id": {
            "type": "string"
          },
          "spare_part_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Total general de la orden"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "supplier_id",
    "company_id",
    "date"
  ]
}