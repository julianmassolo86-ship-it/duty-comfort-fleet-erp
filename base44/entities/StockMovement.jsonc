{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "egreso",
        "ajuste",
        "devolucion"
      ],
      "description": "Tipo de movimiento"
    },
    "spare_part_id": {
      "type": "string",
      "description": "ID del repuesto"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa"
    },
    "quantity": {
      "type": "number",
      "description": "Cantidad del movimiento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del movimiento"
    },
    "origin": {
      "type": "string",
      "enum": [
        "remito_compra",
        "orden_trabajo",
        "ajuste_manual",
        "devolucion"
      ],
      "description": "Origen del movimiento"
    },
    "reference_id": {
      "type": "string",
      "description": "ID del documento origen (remito, OC, etc.)"
    },
    "reference_number": {
      "type": "string",
      "description": "N\u00famero de referencia legible"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario que registr\u00f3"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "type",
    "spare_part_id",
    "company_id",
    "quantity",
    "date"
  ]
}