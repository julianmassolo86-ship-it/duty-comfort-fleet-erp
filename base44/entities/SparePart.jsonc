{
  "name": "SparePart",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del repuesto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n detallada del repuesto"
    },
    "part_number": {
      "type": "string",
      "description": "N\u00famero de pieza OEM"
    },
    "alternative_part_number": {
      "type": "string",
      "description": "N\u00famero de pieza alternativo"
    },
    "manufacturer": {
      "type": "string",
      "description": "Fabricante del repuesto"
    },
    "supplier": {
      "type": "string",
      "description": "Proveedor del repuesto"
    },
    "unit_of_measure": {
      "type": "string",
      "enum": [
        "UNID",
        "LITROS",
        "METROS"
      ],
      "default": "UNID",
      "description": "Unidad de medida"
    },
    "quantity_per_unit": {
      "type": "number",
      "description": "Cantidad por unidad"
    },
    "stock_quantity": {
      "type": "number",
      "default": 0,
      "description": "Cantidad actual en stock"
    },
    "minimum_stock": {
      "type": "number",
      "default": 0,
      "description": "Cantidad m\u00ednima de stock (alerta)"
    },
    "unit_cost": {
      "type": "number",
      "description": "Costo unitario"
    },
    "specifications": {
      "type": "string",
      "description": "Especificaciones t\u00e9cnicas"
    },
    "compatible_manufacturer_id": {
      "type": "string",
      "description": "ID del fabricante de veh\u00edculo compatible (referencia a Manufacturer)"
    },
    "compatible_vehicle_model_id": {
      "type": "string",
      "description": "ID del modelo de veh\u00edculo compatible (referencia a VehicleModel)"
    },
    "company_id": {
      "type": "string",
      "description": "ID de la empresa"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si el repuesto est\u00e1 activo"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "name",
    "unit_of_measure",
    "company_id"
  ]
}